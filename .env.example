PROJECT_NAME="E-Commerce & Kaspi SaaS Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_saas

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=super-secret-key-change-in-production-random-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Kaspi Defaults
KASPI_API_BASE_URL=https://kaspi.kz/merchant/api/v1
